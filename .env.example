# Copy to .env.local and fill in. Never commit .env.local.

# Supabase (Project Settings > API, or `npx supabase status` for the local stack)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Anthropic API key for receipt reading. Server-side only: no NEXT_PUBLIC_ prefix.
ANTHROPIC_API_KEY=
